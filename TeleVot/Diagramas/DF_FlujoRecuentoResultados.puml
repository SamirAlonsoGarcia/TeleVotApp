@startuml
title TeleVotApp - Flujo de recuento y publicación de resultados (con persistencia)

skinparam dpi 200
skinparam defaultFontSize 14
skinparam linetype ortho

start

:Finaliza periodo de votación;

partition "Sistema" {
  :Bloquear emisión de votos;
  :Marcar votación como pendiente de recuento;
}

partition "Junta Electoral" {
  if (¿Autorizar recuento?) then (Sí)
    :Establecer RecuentoAutorizado = True;
  else (No)
    :Recuento no autorizado;
    stop
  endif
}

partition "Mesa Electoral" {
  if (¿Recuento autorizado?) then (Sí)

    if (¿Existe ResultadoVotacion?) then (Sí)
      :Cargar resultados persistidos;
    else (No)
      :Acceder a votos de la votación;
      :Realizar recuento (conteo por candidatura);
      :Determinar candidatura ganadora;

      :Persistir ResultadoVotacion\n(participación + ganadora);
      :Persistir ResultadoCandidatura\n(votos por candidatura);
    endif

    :Publicar resultados / habilitar consulta;
  else (No)
    :Acceso al recuento bloqueado;
  endif
}

partition "Elector" {
  :Consultar resultados de votación finalizada\n(lectura desde BD);
}

:Proceso electoral finalizado;
stop

@enduml